{
  "version": 2,
  "theme": "builtin://dark",
  "locale": "en",
  "keybindings": [
    {
      "key": "F9",
      "action": "lsp_goto_definition",
      "when": "normal"
    }
  ],
  "lsp": {
    "java": {
      "command": "/home/ranly/.local/bin/fresh-jdtls.sh",
      "enabled": true,
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    }
  },
  "plugins": {
    "vi_mode": {
      "enabled": true,
      "settings": {
        "autoStart": false
      }
    }
  }
}